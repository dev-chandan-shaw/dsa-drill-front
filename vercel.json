{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/ssr"
    },
    {
      "source": "/home",
      "destination": "/api/ssr"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dsa-drill.duckdns.org/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://dsa-drill.duckdns.org/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://dsa-drill.duckdns.org/login/oauth2/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.csr.html"
    },
    {
      "source": "/problems-sheet/:path*",
      "destination": "/index.csr.html"
    }
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/dsa-drill-front/**"
    }
  }
}
